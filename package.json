{
  "name": "my-docs",
  "version": "0.0.35",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev --turbo",
    "start": "next start",
    "lint": "npm run types:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "types:check": "next typegen && tsc --noEmit",
    "test": "vitest run && playwright test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "validate:icons": "node scripts/validate-icons.mjs",
    "validate:mermaid": "node scripts/validate-mermaid.mjs",
    "validate:accordions": "node scripts/validate-accordions.mjs",
    "validate": "npm run validate:icons && npm run validate:mermaid && npm run validate:accordions",
    "prepare": "husky"
  },
  "dependencies": {
    "@mermaid-js/parser": "^2.0.1",
    "cn": "^0.3.0",
    "fumadocs-core": "16.15.15",
    "fumadocs-mdx": "15.4.5",
    "fumadocs-twoslash": "^4.0.1",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.15.15",
    "gsap": "^3.15.0",
    "katex": "^0.18.10",
    "lucide-react": "^1.47.0",
    "mermaid": "^12.0.0",
    "motion": "^13.4.4",
    "next": "16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "agent-browser": "^0.39.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  }
}
